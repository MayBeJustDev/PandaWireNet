@code {
    private const string ThemeKey = "pandawirenet-theme";
    private string theme = "light";
    private bool isSending;

    private async Task PreviewSendAsync()
    {
        if (isSending) return;
        isSending = true;
        await Task.Delay(850);
        isSending = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        try
        {
            var savedTheme = await JSRuntime.InvokeAsync<string?>("localStorage.getItem", ThemeKey);
            theme = savedTheme is "light" or "dark" or "korean" ? savedTheme : "light";
            StateHasChanged();
        }
        catch (JSDisconnectedException) { }
        catch (JSException)
        {
            // Browser storage can be disabled; keep the default theme usable.
        }
    }

    private async Task SaveThemeAsync()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("localStorage.setItem", ThemeKey, theme);
        }
        catch (JSDisconnectedException) { }
        catch (JSException)
        {
            // The selected theme still applies for the current session.
        }
    }
}
